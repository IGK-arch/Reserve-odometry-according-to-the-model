<?xml version="1.0"?>
<package format="3">
  <name>tram_odometry</name>
  <version>0.1.0</version>
  <description>Model aided backup odometry for a tram using driver command and two bogie speed sensors.</description>
  <maintainer email="tram-odometry@example.org">Tram Odometry Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>tram_vehicle_msgs</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
